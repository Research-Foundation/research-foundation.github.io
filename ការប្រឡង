        o: ["ទទួលយក Null Hypothesis (H0)", "បដិសេធ Null Hypothesis (H0) មានន័យថាមានភាពខុសគ្នាស្ថិតិ", "ទិន្នន័យខុសទាំងស្រុង", "មិនអាចធ្វើការសន្និដ្ឋានបាន"],
        a: 1
      },
      {
        q: "តើការរៀបចំពិសោធន៍បែប RCBD សមស្របសម្រាប់លក្ខខណ្ឌបែបណា?",
        o: ["អង្គភាពពិសោធន៍មានភាពដូចគ្នាបេះបិទ", "អង្គភាពពិសោធន៍មានកត្តាបំរែបំរួលទិសដៅមួយ (Heterogeneous in one direction)", "ពិសោធន៍គ្មានការព្យាបាល", "ពិសោធន៍ក្នុងបន្ទប់ម៉ាស៊ីនត្រជាក់"],
        a: 1
      },
      {
        q: "តើតេស្ត ANOVA ត្រូវបានប្រើប្រាស់ដើម្បីប្រៀបធៀបអ្វី?",
        o: ["ប្រៀបធៀបមធ្យមភាគចាប់ពី ៣ ក្រុមឡើងទៅ", "ប្រៀបធៀបគម្លាតស្តង់ដារនៃ ២ ក្រុម", "វាស់ទំនោរលីនេអ៊ែរ", "គណនាភាគរយសំណាក"],
        a: 0
      },
      {
        q: "តើកត្តាណាជាសូចនាករវាស់កម្រិតបំរែបំរួលទិន្នន័យជុំវិញតម្លៃមធ្យម?",
        o: ["Mean", "Standard Deviation (SD)", "Mode", "Sample Size (n)"],
        a: 1
      }
    ]
  }
};

let customExams={},draft=null,cur=null,timer=null,left=0,done=false,resRows=[],resExam=null;
const $=id=>document.getElementById(id);
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const isAdmin=()=>sessionStorage.getItem('admin_logged_in')==='true'||localStorage.getItem('RF_ADMIN_LOGGED_IN')==='true';
const cleanName=n=>String(n||'').normalize('NFC').replace(/[\u200B-\u200D\uFEFF]/g,'').replace(/\s+/g,' ').trim();
const nameKey=n=>cleanName(n).toLowerCase().replace(/[\s.#$\[\]\/\\]+/g,'_');

/* ===== storage ===== */
async function loadExams(){
  renderDefaultCards();
  try{
    const r=await fetch(`${DB}/custom_exams.json?_=${Date.now()}`);
    if(r.ok){
      customExams=(await r.json())||{};
      localStorage.setItem('rf_custom_exams',JSON.stringify(customExams));
    }
  }catch(e){
    try{customExams=JSON.parse(localStorage.getItem('rf_custom_exams')||'{}')}catch(_){customExams={}}
  }
  renderCustomCards();
}

async function putExam(e){
  customExams[e.id]=e;
  localStorage.setItem('rf_custom_exams',JSON.stringify(customExams));
  try{
    const r=await fetch(`${DB}/custom_exams/${e.id}.json`,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(e)});
    return r.ok;
  }catch(_){return false}
}

/* ===== admin ===== */
function adminLogin(){
  const p=prompt("សូមបញ្ចូលលេខសម្ងាត់ Admin៖");if(p===null)return;
  if(PASSES.includes(p)){sessionStorage.setItem('admin_logged_in','true');renderAdmin();renderDefaultCards();renderCustomCards();}
  else alert("លេខសម្ងាត់មិនត្រឹមត្រូវ!");
}
function adminLogout(){
  sessionStorage.removeItem('admin_logged_in');
  localStorage.removeItem('RF_ADMIN_LOGGED_IN');
  renderAdmin();
  renderDefaultCards();
  renderCustomCards();
}
function renderAdmin(){
  const a=isAdmin();
  document.querySelectorAll('.toolbar .admin-only').forEach(el=>el.style.display=a?'inline-block':'none');
  $('loginBtn').style.display=a?'none':'inline-block';
}

/* ===== cards ===== */
function createCardHTML(e, isCustom=false){
  return `
    <div class="exam-card" onclick="openExam('${esc(e.id)}')">
      ${isAdmin()?`<div class="card-admin" onclick="event.stopPropagation()">
        <button onclick="openResults('${esc(e.id)}')">📊</button>
        ${isCustom?`<button onclick="openBuilder('${esc(e.id)}')">✏️</button><button onclick="delExam('${esc(e.id)}')">🗑️</button>`:''}
      </div>`:''}
      <div class="exam-icon">${esc(e.icon||'📝')}</div>
      <h3>${esc(e.title)}</h3>
      <p>${esc(e.desc||'')}</p>
      <div class="meta">${e.questions.length} សំណួរ • ${e.minutes} នាទី • ជាប់ ≥ ${e.pass}</div>
      <span class="btn-start">ចាប់ផ្តើមប្រឡង →</span>
    </div>`;
}

function renderDefaultCards(){
  const list=Object.values(DEFAULT_EXAMS);
  $('defaultGrid').innerHTML=list.map(e=>createCardHTML(e, false)).join('');
}

function renderCustomCards(){
  const list=Object.values(customExams).sort((a,b)=>(b.created||0)-(a.created||0));
  $('customEmpty').style.display=list.length?'none':'block';
  $('customGrid').innerHTML=list.map(e=>createCardHTML(e, true)).join('');
}

function closeOv(id){$(id).classList.remove('open')}

/* ===== builder ===== */
function blankQ(){return{q:'',o:['','','',''],a:0}}
function openBuilder(id){
  const e=id?(customExams[id]||DEFAULT_EXAMS[id]):null;
  draft=e?JSON.parse(JSON.stringify(e)):{id:'e'+Date.now(),title:'',icon:'📝',desc:'',minutes:30,pass:2,questions:[blankQ()],created:Date.now()};
  if(id&&DEFAULT_EXAMS[id]) draft.id='e'+Date.now(); // Duplicate if based on default
  $('bTitle').textContent=e?'កែសម្រួលតេស្ត':'បង្កើតតេស្តថ្មី';
  $('bIcon').value=draft.icon;$('bName').value=draft.title;$('bMin').value=draft.minutes;$('bPass').value=draft.pass;$('bDesc').value=draft.desc||'';
  renderQ();$('builderOv').classList.add('open');
}
function syncDraft(){
  draft.icon=$('bIcon').value||'📝';draft.title=$('bName').value.trim();draft.desc=$('bDesc').value.trim();
  draft.minutes=Math.max(1,+$('bMin').value||30);draft.pass=Math.max(0,+$('bPass').value||0);
  draft.questions=[...document.querySelectorAll('.qe')].map((el,i)=>({
    q:el.querySelector('.qt').value.trim(),
    o:[...el.querySelectorAll('.qo')].map(x=>x.value.trim()),
    a:+(el.querySelector('input[type=radio]:checked')?.value||0)
  }));
}
function renderQ(){
  $('qList').innerHTML=draft.questions.map((q,i)=>`
    <div class="qe"><div class="qh"><b>សំណួរទី ${i+1}</b><button class="tb red" style="padding:3px 10px" onclick="delQ(${i})">លុប</button></div>
      <textarea class="qt" placeholder="វាយសំណួរនៅទីនេះ...">${esc(q.q)}</textarea>
      ${q.o.map((o,k)=>`<div class="oe"><input type="radio" name="c${i}" value="${k}" ${q.a===k?'checked':''}><b>${LET[k]}</b><input type="text" class="qo" value="${esc(o)}" placeholder="ជម្រើស ${LET[k]}"></div>`).join('')}
    </div>`).join('');
}
function addQ(){syncDraft();draft.questions.push(blankQ());renderQ();$('qList').lastElementChild.scrollIntoView({behavior:'smooth'})}
function delQ(i){syncDraft();if(draft.questions.length<=1)return alert('ត្រូវមានយ៉ាងតិច ១ សំណួរ!');draft.questions.splice(i,1);renderQ()}
async function saveExam(){
  syncDraft();
  if(!draft.title)return alert('សូមបញ្ចូលឈ្មោះតេស្ត!');
  for(let i=0;i<draft.questions.length;i++){
    const q=draft.questions[i];
    if(!q.q||q.o.some(x=>!x))return alert(`សំណួរទី ${i+1} មិនទាន់បំពេញគ្រប់ (សំណួរ និងជម្រើសទាំង ៤)!`);
  }
  if(draft.pass>draft.questions.length)return alert('ពិន្ទុជាប់លើសចំនួនសំណួរ!');
  const ok=await putExam(draft);
  closeOv('builderOv');renderCustomCards();
  if(!ok)alert('រក្សាទុកក្នុង Browser ប៉ុណ្ណោះ (មិនអាចភ្ជាប់ Cloud)។');
}
async function delExam(id){
  if(!confirm(`លុបតេស្ត "${customExams[id].title}" និងលទ្ធផលទាំងអស់?`))return;
  delete customExams[id];localStorage.setItem('rf_custom_exams',JSON.stringify(customExams));
  try{await fetch(`${DB}/custom_exams/${id}.json`,{method:'DELETE'});await fetch(`${DB}/custom_results/${id}.json`,{method:'DELETE'})}catch(_){}
  renderCustomCards();
}

/* ===== taker ===== */
function openExam(id){
  cur = DEFAULT_EXAMS[id] || customExams[id];
  if(!cur)return;
  done=false;clearInterval(timer);
  $('tTitle').textContent=`${cur.icon||'📝'} ${cur.title}`;
  $('tInfo').textContent=`${cur.questions.length} សំណួរ • រយៈពេល ${cur.minutes} នាទី • ពិន្ទុជាប់ ≥ ${cur.pass}។ នាឡិកានឹងរាប់ថយក្រោយ ហើយបញ្ជូនចម្លើយដោយស្វ័យប្រវត្តិពេលអស់ម៉ោង។`;
  $('tName').value='';$('tName').readOnly=false;
  $('tStart').style.display='block';$('tBody').style.display='none';$('tResult').style.display='none';$('timer').style.display='none';
  $('takeOv').classList.add('open');
}
function closeTake(){clearInterval(timer);closeOv('takeOv')}
function startExam(){
  if(!cleanName($('tName').value))return alert('សូមបញ្ចូលឈ្មោះនិស្សិតជាមុនសិន!');
  $('tName').readOnly=true;
  $('tQs').innerHTML=cur.questions.map((q,i)=>`<div class="qc"><div class="qt2">${i+1}. ${esc(q.q)}</div>
    ${q.o.map((o,k)=>`<label class="opt"><input type="radio" name="a${i}" value="${k}"> ${LET[k]}. ${esc(o)}</label>`).join('')}</div>`).join('');
  $('tStart').style.display='none';$('tBody').style.display='block';
  left=cur.minutes*60;$('timer').style.display='flex';tick();
  timer=setInterval(()=>{left--;tick();if(left<=0){clearInterval(timer);alert('⏰ អស់ពេល! ប្រព័ន្ធនឹងបញ្ជូនចម្លើយដោយស្វ័យប្រវត្តិ។');submitExam()}},1000);
}
function tick(){
  const m=Math.floor(Math.max(left,0)/60),s=Math.max(left,0)%60;
  $('timerTxt').textContent=`${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`;
  $('timer').classList.toggle('warn',left<=60);
}
async function submitExam(){
  if(done)return;done=true;clearInterval(timer);
  let score=0;const total=cur.questions.length;
  cur.questions.forEach((q,i)=>{
    const sel=document.querySelector(`input[name="a${i}"]:checked`);
    const box=document.querySelectorAll('#tQs .qc')[i];
    box.querySelectorAll('.opt').forEach((lb,k)=>{
      lb.querySelector('input').disabled=true;
      if(k===q.a)lb.classList.add('ok');
      else if(sel&&+sel.value===k)lb.classList.add('bad');
    });
    if(sel&&+sel.value===q.a)score++;
  });
  $('timer').style.display='none';
  const passed=score>=cur.pass,name=cleanName($('tName').value),date=new Date().toISOString().slice(0,10);
  $('tBody').querySelector('.actions').style.display='none';
  const r=$('tResult');r.style.display='block';
  r.innerHTML=`<div class="big">${score} / ${total}</div>
    <div class="pill" style="background:${passed?'#16a34a':'#dc2626'}">${passed?'✓ ជាប់ (Passed)':'✗ មិនទាន់ជាប់ (Not Passed)'}</div>
    <p style="color:#94a3b8;font-size:.9rem">${esc(name)} • ${date}<br>ចម្លើយត្រឹមត្រូវបង្ហាញជាពណ៌បៃតងខាងលើ។</p>
    <div class="actions" style="justify-content:center"><button class="tb green" onclick="closeTake()">បិទ</button></div>`;
  r.scrollIntoView({behavior:'smooth'});
  const rec={name,score,total,passed,date};
  try{await fetch(`${DB}/custom_results/${cur.id}/${nameKey(name)}.json`,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(rec)})}catch(_){}
}

/* ===== results (admin) ===== */
async function openResults(id){
  resExam = DEFAULT_EXAMS[id] || customExams[id];
  $('rTitle').textContent=`📊 លទ្ធផល៖ ${resExam.title}`;
  $('rBody').innerHTML='<tr><td colspan="6">កំពុងទាញទិន្នន័យ...</td></tr>';
  $('resOv').classList.add('open');
  let data={};
  try{const r=await fetch(`${DB}/custom_results/${id}.json?_=${Date.now()}`);data=(await r.json())||{}}catch(_){}
  resRows=Object.entries(data).map(([k,v])=>({k,...v})).sort((a,b)=>b.score-a.score);
  $('rBody').innerHTML=resRows.length?resRows.map((r,i)=>`<tr><td>${i+1}</td><td><b>${esc(r.name)}</b></td><td>${r.score}/${r.total}</td>
    <td style="color:${r.passed?'#4ade80':'#f87171'}">${r.passed?'ជាប់':'មិនជាប់'}</td><td>${esc(r.date)}</td>
    <td><button class="tb red" style="padding:3px 9px" onclick="delResult('${esc(id)}','${esc(r.k)}')">លុប</button></td></tr>`).join('')
    :'<tr><td colspan="6" style="text-align:center;color:#64748b">មិនទាន់មានលទ្ធផលទេ។</td></tr>';
}
async function delResult(id,k){
  if(!confirm('លុបលទ្ធផលនេះ?'))return;
  try{await fetch(`${DB}/custom_results/${id}/${k}.json`,{method:'DELETE'})}catch(_){}
  openResults(id);
}
function exportCSV(){
  if(!resRows.length)return alert('គ្មានទិន្នន័យ!');
  const c=v=>`"${String(v).replace(/"/g,'""')}"`;
  let s="\uFEFFល.រ,ឈ្មោះ,ពិន្ទុ,សរុប,ស្ថានភាព,កាលបរិច្ឆេទ\n";
  resRows.forEach((r,i)=>s+=[i+1,r.name,r.score,r.total,r.passed?'ជាប់':'មិនជាប់',r.date].map(c).join(',')+"\n");
  const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([s],{type:'text/csv;charset=utf-8;'}));
  a.download=`${resExam.title}_results.csv`;document.body.appendChild(a);a.click();a.remove();
}

renderAdmin();
loadExams();
</script>
