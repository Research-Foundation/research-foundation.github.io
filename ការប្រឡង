<!DOCTYPE html>
<html lang="km">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ការប្រឡង - Research Foundation</title>
<link href="https://fonts.googleapis.com/css2?family=Kantumruy+Pro:wght@400;600;700&display=swap" rel="stylesheet">
<style>
*{box-sizing:border-box;margin:0;padding:0;font-family:'Kantumruy Pro',sans-serif}
body{background:#0d131a;color:#fff;min-height:100vh;display:flex;flex-direction:column;align-items:center;padding:40px 20px}
.header-container{text-align:center;max-width:700px;margin-bottom:30px}
.header-container h1{font-size:2.2rem;color:#4ade80;margin-bottom:12px}
.header-container p{color:#94a3b8;font-size:1rem}
.toolbar{width:100%;max-width:960px;display:flex;justify-content:flex-end;gap:8px;margin-bottom:18px;flex-wrap:wrap}
.tb{border:1px solid #1e293b;background:#16202c;color:#cbd5e1;padding:8px 14px;border-radius:8px;font-size:.85rem;font-weight:600;cursor:pointer;transition:.2s}
.tb:hover{border-color:#00d26a;color:#4ade80}
.tb.green{background:#00d26a;color:#0d131a;border-color:#00d26a}
.tb.red{color:#f87171}.tb.red:hover{border-color:#f87171;color:#f87171}
.admin-only{display:none}
.exam-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:24px;width:100%;max-width:960px;margin-bottom:24px}
.exam-card{background:#16202c;border:1px solid #1e293b;border-radius:16px;padding:30px 24px;text-decoration:none;color:#fff;display:flex;flex-direction:column;align-items:flex-start;transition:all .3s ease;box-shadow:0 4px 20px rgba(0,0,0,.25);position:relative;cursor:pointer}
.exam-card:hover{transform:translateY(-5px);border-color:#00d26a;box-shadow:0 8px 30px rgba(0,210,106,.2);background:#1b2737}
.exam-icon{font-size:2.2rem;margin-bottom:16px;background:rgba(0,210,106,.1);width:55px;height:55px;display:flex;align-items:center;justify-content:center;border-radius:12px}
.exam-card h3{font-size:1.3rem;color:#f8fafc;margin-bottom:8px}
.exam-card p{font-size:.9rem;color:#94a3b8;line-height:1.5;margin-bottom:14px;flex-grow:1}
.meta{font-size:.78rem;color:#64748b;margin-bottom:16px}
.btn-start{display:inline-block;background:#00d26a;color:#0d131a;font-weight:700;padding:8px 18px;border-radius:8px;font-size:.9rem}
.card-admin{position:absolute;top:12px;right:12px;display:flex;gap:6px}
.card-admin button{background:#0d131a;border:1px solid #1e293b;color:#cbd5e1;border-radius:6px;padding:4px 8px;font-size:.75rem;cursor:pointer}
.card-admin button:hover{border-color:#00d26a;color:#4ade80}
.sec-title{width:100%;max-width:960px;font-size:1.05rem;color:#4ade80;margin:12px 0 14px;font-weight:700}
.empty{width:100%;max-width:960px;text-align:center;color:#64748b;padding:18px;border:1px dashed #1e293b;border-radius:12px;margin-bottom:24px;font-size:.9rem}
.back-link{margin-top:30px;color:#64748b;text-decoration:none;font-size:.95rem;transition:color .2s;cursor:pointer}
.back-link:hover{color:#4ade80}

/* modal */
.ov{position:fixed;inset:0;background:rgba(0,0,0,.8);display:none;align-items:flex-start;justify-content:center;padding:24px 14px;overflow-y:auto;z-index:50}
.ov.open{display:flex}
.box{background:#111a24;border:1px solid #1e293b;border-radius:16px;width:100%;max-width:760px;padding:24px;box-shadow:0 20px 50px rgba(0,0,0,.5)}
.box h2{color:#4ade80;font-size:1.25rem;margin-bottom:16px}
.row{display:grid;gap:12px;margin-bottom:12px}
.r2{grid-template-columns:1fr 1fr}.r4{grid-template-columns:80px 1fr 110px 110px}
@media(max-width:640px){.r2,.r4{grid-template-columns:1fr}}
label.l{display:block;font-size:.82rem;color:#94a3b8;margin-bottom:4px}
input[type=text],input[type=number],textarea{width:100%;background:#0d131a;border:1px solid #1e293b;color:#fff;border-radius:8px;padding:9px 12px;font-size:.92rem;outline:none}
input:focus,textarea:focus{border-color:#00d26a}
textarea{resize:vertical;min-height:60px}
.qe{background:#16202c;border:1px solid #1e293b;border-radius:10px;padding:14px;margin-bottom:12px}
.qh{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;font-size:.9rem}
.oe{display:flex;align-items:center;gap:8px;margin-top:8px;font-size:.85rem}
.oe input[type=radio]{accent-color:#00d26a;width:18px;height:18px;flex-shrink:0}
.oe b{width:18px;color:#4ade80}
.actions{display:flex;justify-content:flex-end;gap:10px;margin-top:18px;flex-wrap:wrap}
.hint{font-size:.78rem;color:#64748b;margin-top:6px}

/* taker */
.timer{position:sticky;top:0;background:#0d131a;border:1px solid #1e293b;border-radius:30px;padding:8px 18px;display:none;justify-content:space-between;margin-bottom:14px;font-weight:600;z-index:2}
.timer span:last-child{color:#38bdf8;font-family:monospace;font-size:1.15rem}
.timer.warn span:last-child{color:#ef4444}
.qc{background:#16202c;border:1px solid #1e293b;border-radius:10px;padding:14px 16px;margin-bottom:12px}
.qt2{font-weight:600;margin-bottom:10px;line-height:1.5}
.opt{display:flex;align-items:center;gap:10px;padding:9px 12px;border:1px solid #1e293b;border-radius:8px;margin-bottom:6px;cursor:pointer;background:#0d131a;font-size:.93rem}
.opt:hover{border-color:#00d26a}
.opt input{accent-color:#00d26a;width:17px;height:17px}
.opt.ok{border-color:#16a34a;background:rgba(22,163,74,.15)}
.opt.bad{border-color:#dc2626;background:rgba(220,38,38,.15)}
.result{text-align:center;padding:16px 0}
.big{font-size:2.2rem;font-weight:700;color:#4ade80}
.pill{display:inline-block;padding:6px 18px;border-radius:20px;font-weight:700;margin:10px 0}
table{width:100%;border-collapse:collapse;font-size:.9rem}
th,td{padding:9px 10px;border-bottom:1px solid #1e293b;text-align:left}
th{color:#94a3b8;font-weight:600}
.tw{overflow-x:auto}
</style>
</head>
<body>

<div class="header-container">
  <h1>មជ្ឈមណ្ឌលប្រឡង និងតេស្តសមត្ថភាព</h1>
  <p>សូមជ្រើសរើសមុខវិជ្ជាខាងក្រោមដើម្បីចាប់ផ្តើមធ្វើតេស្តវាស់ស្ទង់សមត្ថភាពរបស់អ្នក</p>
</div>

<div class="toolbar">
  <button class="tb green admin-only" onclick="openBuilder()">➕ បង្កើតតេស្តថ្មី</button>
  <button class="tb admin-only" id="adminTag" style="cursor:default">✓ Admin</button>
  <button class="tb red admin-only" onclick="adminLogout()">ចាកចេញ</button>
  <button class="tb" id="loginBtn" onclick="adminLogin()">🔒 Admin Login</button>
</div>

<div class="sec-title">📚 តេស្តមុខវិជ្ជាគោល</div>
<div class="exam-grid" id="defaultGrid"></div>

<div class="sec-title">✨ តេស្តដែលបង្កើតបន្ថែម</div>
<div id="customEmpty" class="empty">មិនទាន់មានតេស្តបន្ថែមនៅឡើយទេ។</div>
<div class="exam-grid" id="customGrid"></div>

<a href="javascript:history.back()" class="back-link">← ត្រឡប់ទៅទំព័រដើមវិញ</a>

<!-- BUILDER -->
<div class="ov" id="builderOv"><div class="box">
  <h2 id="bTitle">បង្កើតតេស្តថ្មី</h2>
  <div class="row r4">
    <div><label class="l">Icon</label><input type="text" id="bIcon" maxlength="4" value="📝"></div>
    <div><label class="l">ឈ្មោះតេស្ត *</label><input type="text" id="bName" placeholder="ឧ. តេស្តស្ថិតិ"></div>
    <div><label class="l">រយៈពេល (នាទី)</label><input type="number" id="bMin" min="1" value="30"></div>
    <div><label class="l">ពិន្ទុជាប់ (≥)</label><input type="number" id="bPass" min="0" value="2"></div>
  </div>
  <div class="row"><div><label class="l">ការពិពណ៌នា</label><input type="text" id="bDesc" placeholder="សេចក្តីពិពណ៌នាខ្លី..."></div></div>
  <div id="qList"></div>
  <button class="tb" onclick="addQ()">➕ បន្ថែមសំណួរ</button>
  <div class="hint">ចុចប៊ូតុងរង្វង់ ដើម្បីជ្រើសចម្លើយត្រឹមត្រូវ។</div>
  <div class="actions">
    <button class="tb" onclick="closeOv('builderOv')">បោះបង់</button>
    <button class="tb green" onclick="saveExam()">💾 រក្សាទុកតេស្ត</button>
  </div>
</div></div>

<!-- TAKER -->
<div class="ov" id="takeOv"><div class="box">
  <h2 id="tTitle"></h2>
  <div class="timer" id="timer"><span>⏱️ ពេលវេលានៅសល់៖</span><span id="timerTxt">00:00</span></div>
  <div id="tStart">
    <p id="tInfo" style="color:#94a3b8;margin-bottom:14px;font-size:.92rem"></p>
    <label class="l">ឈ្មោះនិស្សិត *</label>
    <input type="text" id="tName" placeholder="បញ្ចូលឈ្មោះពេញ...">
    <div class="actions">
      <button class="tb" onclick="closeTake()">បិទ</button>
      <button class="tb green" onclick="startExam()">▶ ចាប់ផ្ដើមធ្វើតេស្ត</button>
    </div>
  </div>
  <div id="tBody" style="display:none">
    <div id="tQs"></div>
    <div class="actions"><button class="tb green" onclick="if(confirm('តើអ្នកចង់ផ្ញើចម្លើយមែនទេ?'))submitExam()">ផ្ញើចម្លើយបញ្ចប់តេស្ត</button></div>
  </div>
  <div id="tResult" class="result" style="display:none"></div>
</div></div>

<!-- RESULTS -->
<div class="ov" id="resOv"><div class="box">
  <h2 id="rTitle">លទ្ធផល</h2>
  <div class="tw"><table><thead><tr><th>ល.រ</th><th>ឈ្មោះ</th><th>ពិន្ទុ</th><th>ស្ថានភាព</th><th>កាលបរិច្ឆេទ</th><th class="admin-only" style="display:none">លុប</th></tr></thead><tbody id="rBody"></tbody></table></div>
  <div class="actions"><button class="tb" onclick="exportCSV()">ទាញយក CSV</button><button class="tb" onclick="closeOv('resOv')">បិទ</button></div>
</div></div>

<script>
